PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/buildspec
# Local photos are convenient for development. Production requires Supabase Storage.
PHOTO_STORAGE=local
# For Supabase photos, set PHOTO_STORAGE=supabase and provide both values below.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
GITHUB_ALLOWED_USER_ID=186479337
# For a separate-site production frontend, use none (requires HTTPS).
COOKIE_SAME_SITE=lax
