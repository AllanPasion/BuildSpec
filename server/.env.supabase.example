PORT=3000
CLIENT_URL=http://localhost:5173
# Copy the Session pooler URL from the Supabase dashboard's Connect panel.
# Use port 5432. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?uselibpqcompat=true&sslmode=require
